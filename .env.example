# ON A MAC, PREFER THE KEYCHAIN — you do not need this file:
#     node scripts/credentials.mjs set MANATAL_API_KEY
#     node scripts/credentials.mjs list
# Already have a .env? `node scripts/credentials.mjs import` moves it in.
#
# This file is the fallback for Linux and cloud sessions, where there is no
# Keychain. Copy it to .env and fill in only what you use. .env is git-ignored,
# so your keys never leave this computer — but it IS plaintext on disk.
# Leave a line blank or delete it if you don't use that tool.

# Manatal (job posting / ATS) — Settings -> Integrations -> Open API
MANATAL_API_KEY=

# GoHighLevel — Settings -> Private Integrations. Must start with pit-
GHL_API_KEY=

# GoHighLevel inbound webhook that receives Manatal applicants.
# Automation -> Workflows -> new workflow -> "Inbound Webhook" trigger -> copy URL.
# Treat it like a password: anyone with it can inject contacts into the CRM.
GHL_APPLICANT_WEBHOOK_URL=

# Website FTP — from your hosting control panel
FTP_HOST=
FTP_USER=
FTP_PASSWORD=

# OPTIONAL, advanced: only needed for generating 100+ city postings in one run.
# Pay-as-you-go API billing from console.anthropic.com, separate from a Claude subscription.
ANTHROPIC_API_KEY=
